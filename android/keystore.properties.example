# Copy to android/keystore.properties and fill in your own values.
#
# app/build.gradle reads this file to sign release builds. It is git-ignored —
# never commit the real file or the keystore itself.
#
# storeFile is resolved relative to the android/ directory.
storeFile=medremind-release.jks
storePassword=CHANGE_ME
keyAlias=medremind
keyPassword=CHANGE_ME
